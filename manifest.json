{
  "manifest_version": 3,
  "name": "osu! Profile Studio",
  "version": "1.3.0",
  "description": "Personalize osu! profiles, navigation, chart colors, cover art, wallpapers and glass surfaces.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://osu.ppy.sh/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "osu! Profile Studio"
  },
  "content_scripts": [
    {
      "matches": [
        "https://osu.ppy.sh/users/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
